# One variable per line, as in the README's Configuration. Every one is
# optional; an empty file leaves every default. STORAGE_MAX_MB must fit the
# 64Mi volume, with room for a day being rewritten -- enlarge the claim
# for more.
STORAGE_DIR=/var/lib/kubeloupe/metrics
STORAGE_RETENTION_DAYS=30
STORAGE_MAX_MB=48
# Logs, with the token in the Secret kubeloupe-logs (see the README's Logs):
# LOG_TARGETS=meet/meet-=7d
# LOG_MAX_MB=8
